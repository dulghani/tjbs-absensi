APP_NAME="OutsourceHR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://outsourcehr.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Default Laragon: MySQL, user root, tanpa password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=outsourcehr
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue ───────────────────────────────────────────────────
# Sengaja pakai 'database' (bukan redis) supaya tidak perlu install Redis terpisah.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Sanctum (auth API untuk frontend React) ──────────────────────────────────
# Tambahkan domain .test Laragon Anda di sini kalau pakai fitur auto-vhost.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,outsourcehr.test

# ── CORS (izinkan frontend React akses API) ──────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://outsourcehr.test

# ── Mail (untuk kirim password sementara, notifikasi, dll) ───────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@outsourcehr.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Fingerspot (opsional) ─────────────────────────────────────────────────────
FINGERSPOT_DEFAULT_TIMEZONE=Asia/Jakarta

# ── Konfigurasi Email (isi saat domain email sudah siap) ──────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email_anda@gmail.com
MAIL_PASSWORD=app_password_16_karakter
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@domain-anda.com
MAIL_FROM_NAME="OutsourceHR"

# Alternatif jika pakai hosting cPanel (Namecheap, Niagahoster, dll):
# MAIL_HOST=mail.domain-anda.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
